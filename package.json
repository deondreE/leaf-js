{
  "name": "leaf",
  "version": "2.0.3",
  "type": "module",
  "description": "A performant 3d javascript library",
  "source": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/deondreE/leaf-js"
  },
  "bugs": {
    "url": "https://github.com/deondreE/leaf-js/issues"
  },
  "homepage": "https://github.com/deondreE/leaf-js#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "require": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "build:types": "dts-bundle-generator -o dist/leaf.d.ts src/index.ts",
    "dev:rollup": "rollup -c -w",
    "format": "prettier --write .",
    "lint": "oxlint src --fix"
  },
  "author": "deondreE",
  "license": "zLib",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.13.2",
    "@types/uuid": "^10.0.0",
    "@webgpu/types": "^0.1.52",
    "dts-bundle-generator": "^9.5.1",
    "oxlint": "^1.25.0",
    "prettier": "^3.6.2",
    "rollup": "^4.52.5",
    "rollup-plugin-typescript3": "^3.0.5",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-raw-plugin": "^1.0.2"
  },
  "dependencies": {
    "fbx-parser": "^2.1.3",
    "gl-matrix": "^3.4.3",
    "uuid": "^11.1.0",
    "vitest": "^3.0.5",
    "wgpu-matrix": "^3.3.0"
  }
}
